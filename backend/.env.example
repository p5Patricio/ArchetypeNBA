# Copy this file to backend/.env and replace the placeholders. backend/.env is git-ignored: never commit it and
# never paste it in a chat or an issue (it holds API keys and the database password).
# Every setting below mirrors backend/app/config.py; a value left out falls back to the default shown here.
# A value that contains "your_" is treated as "not configured" by the Odds, Gemini and Telegram services.

# --- Database ---
# PostgreSQL connection URL (the app rewrites postgresql:// to postgresql+psycopg://, the psycopg 3 driver).
# Percent-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql://nba:change_me@localhost:5432/nba_platform
# Optional cache for the API; the API runs without Redis (it just does not cache).
REDIS_URL=redis://localhost:6379/0

# --- API server ---
# Browser origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:38920","http://127.0.0.1:38920","http://localhost:38921","http://127.0.0.1:38921","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","http://localhost:8001","http://127.0.0.1:8001"]
DEBUG=false
# Defined in config.py but not read anywhere at the moment (kept for the legacy ETL).
ETL_BATCH_SIZE=100

# --- AI and notifications (all optional) ---
# Google Gemini key for the qualitative injury/lineup layer: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Telegram bot token from @BotFather and the chat id that should receive the alerts.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Odds ---
# The Odds API key: https://the-odds-api.com (the free tier gives 500 credits per month).
# The capture tick spends these credits; only ONE machine may run the tick with a given key (docs/DB_TRANSFER.md).
THE_ODDS_API_KEY=your_the_odds_api_key_here
# Monte Carlo runs per player prop.
PROPS_SIMULATION_RUNS=10000

# --- Model learning loop (defaults shown) ---
# Paired games a challenger needs before it can be promoted.
LEARNING_MIN_GAMES=150
# Days a challenger must have been live before it can be promoted.
LEARNING_MIN_DAYS_LIVE=14
# Days between two promotions.
LEARNING_COOLDOWN_DAYS=30
# Kill switch: false = evaluate and report only, never promote.
LEARNING_AUTOPROMOTE=true
# At most one candidate search (the model lab) every this many days.
LEARNING_PROPOSAL_DAYS=7
# Maximum challengers active at the same time.
LEARNING_MAX_CHALLENGERS=3
# At most one decision-grade look per challenger every this many days.
LEARNING_LOOK_INTERVAL_DAYS=7
# Maximum decision-grade looks per champion/challenger pairing.
LEARNING_MAX_LOOKS=12
# A challenger whose look budget is spent without a promotion leaves once older than this many days (with >= 300 games).
LEARNING_MAX_AGE_DAYS=150
